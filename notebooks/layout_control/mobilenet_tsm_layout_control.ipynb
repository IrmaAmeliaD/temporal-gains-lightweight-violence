      ],
      "source": [
        "\n",
        "# ============================================================\n",
        "# PAIRED GROUPED vs INTERLEAVED ANALYSIS\n",
        "# ============================================================\n",
        "metric_names = [\"accuracy\", \"f1_macro\", \"roc_auc\", \"average_precision\"]\n",
        "key_cols = [\"spec_name\", \"checkpoint_seed\", \"native_t\", \"k_train\", \"train_layout\", \"k_test\", \"repeat_id\", \"dataset\"]\n",
        "\n",
        "wide = metrics_df.pivot_table(\n",
        "    index=key_cols,\n",
        "    columns=\"test_layout\",\n",
        "    values=metric_names,\n",
        "    aggfunc=\"first\",\n",
        ").reset_index()\n",
        "wide.columns = [\n",
        "    \"_\".join([str(x) for x in col if str(x) != \"\"]) if isinstance(col, tuple) else str(col)\n",
        "    for col in wide.columns\n",
        "]\n",
        "\n",
        "for m in metric_names:\n",
        "    wide[f\"delta_{m}_interleaved_minus_grouped\"] = wide[f\"{m}_interleaved\"] - wide[f\"{m}_grouped\"]\n",
        "    wide[f\"delta_{m}_pp\"] = 100.0 * wide[f\"delta_{m}_interleaved_minus_grouped\"]\n",
        "\n",
        "paired_metrics_path = EVAL_OUTPUT_DIR / \"paired_layout_metric_deltas_per_repeat.csv\"\n",
        "wide.to_csv(paired_metrics_path, index=False)\n",
        "\n",
        "# Sample-level probability/layout sensitivity. We pair exact same clip/repeat/K.\n",
        "def make_paired_prediction_diagnostics(pred_df):\n",
        "    rows = []\n",
        "    group_keys = [\"spec_name\", \"checkpoint_seed\", \"native_t\", \"k_train\", \"train_layout\", \"k_test\", \"repeat_id\"]\n",
        "\n",
        "    # individual datasets + synthetic SOURCE_POOLED\n",
        "    datasets = list(TEST_STORES.keys()) + [\"SOURCE_POOLED\"]\n",
        "    for key, g in pred_df.groupby(group_keys, sort=False):\n",
        "        meta = dict(zip(group_keys, key if isinstance(key, tuple) else (key,)))\n",
        "        for ds in datasets:\n",
        "            if ds == \"SOURCE_POOLED\":\n",
        "                gd = g[g[\"dataset\"].isin(POOLED_DATASETS)].copy()\n",
        "                gd[\"pair_key\"] = gd[\"dataset\"].astype(str) + \"::\" + gd[\"sample_index\"].astype(str)\n",
        "            else:\n",
        "                gd = g[g[\"dataset\"] == ds].copy()\n",
        "                gd[\"pair_key\"] = gd[\"sample_index\"].astype(str)\n",
        "            if gd.empty:\n",
        "                continue\n",
        "\n",
        "            a = gd[gd[\"test_layout\"] == \"grouped\"][[\"pair_key\",\"y_true\",\"y_pred\",\"p_violence\"]].rename(\n",
        "                columns={\"y_pred\":\"y_pred_grouped\",\"p_violence\":\"p_grouped\"}\n",
        "            )\n",
        "            b = gd[gd[\"test_layout\"] == \"interleaved\"][[\"pair_key\",\"y_true\",\"y_pred\",\"p_violence\"]].rename(\n",
        "                columns={\"y_pred\":\"y_pred_interleaved\",\"p_violence\":\"p_interleaved\"}\n",
        "            )\n",
        "            merged = a.merge(b, on=[\"pair_key\",\"y_true\"], how=\"inner\", validate=\"one_to_one\")\n",
        "            if len(merged) == 0:\n",
        "                continue\n",
        "\n",
        "            abs_dp = np.abs(merged[\"p_interleaved\"].to_numpy() - merged[\"p_grouped\"].to_numpy())\n",
        "            flips = (merged[\"y_pred_interleaved\"].to_numpy() != merged[\"y_pred_grouped\"].to_numpy())\n",
        "            rho = spearmanr(merged[\"p_grouped\"], merged[\"p_interleaved\"]).statistic\n",
        "\n",
        "            row = dict(meta)\n",
        "            row.update({\n",
        "                \"dataset\": ds,\n",
        "                \"n\": len(merged),\n",
        "                \"mean_abs_delta_p\": float(np.mean(abs_dp)),\n",
        "                \"median_abs_delta_p\": float(np.median(abs_dp)),\n",
        "                \"p90_abs_delta_p\": float(np.quantile(abs_dp, 0.90)),\n",
        "                \"max_abs_delta_p\": float(np.max(abs_dp)),\n",
        "                \"prediction_flip_rate\": float(np.mean(flips)),\n",
        "                \"spearman_rho\": float(rho),\n",
        "            })\n",
        "            rows.append(row)\n",
        "    return pd.DataFrame(rows)\n",
        "\n",
        "pred_diag_df = make_paired_prediction_diagnostics(predictions_df)\n",
        "pred_diag_path = EVAL_OUTPUT_DIR / \"paired_layout_prediction_diagnostics_per_repeat.csv\"\n",
        "pred_diag_df.to_csv(pred_diag_path, index=False)\n",
        "\n",
        "# Within-seed summary: sampling-repeat mean/SD.\n",
        "delta_cols = [f\"delta_{m}_pp\" for m in metric_names]\n",
        "seed_summary = (\n",
        "    wide.groupby([\"spec_name\",\"checkpoint_seed\",\"native_t\",\"k_train\",\"train_layout\",\"k_test\",\"dataset\"], dropna=False)\n",
        "        [delta_cols]\n",
        "        .agg([\"mean\",\"std\"])\n",
        "        .reset_index()\n",
        ")\n",
        "seed_summary.columns = [\n",
        "    \"_\".join([str(x) for x in col if str(x) != \"\"]) if isinstance(col, tuple) else str(col)\n",
        "    for col in seed_summary.columns\n",
        "]\n",
        "seed_summary_path = EVAL_OUTPUT_DIR / \"layout_effect_within_seed_summary.csv\"\n",
        "seed_summary.to_csv(seed_summary_path, index=False)\n",
        "\n",
        "# Condition AP summary per seed (grouped/interleaved) first across repeats.\n",
        "ap_seed = (\n",
        "    metrics_df.groupby([\"spec_name\",\"checkpoint_seed\",\"native_t\",\"k_train\",\"train_layout\",\"k_test\",\"test_layout\",\"dataset\"], dropna=False)\n",
        "    [\"average_precision\"].mean().reset_index(name=\"AP_repeat_mean\")\n",
        ")\n",
        "\n",
        "# 3-seed summary: variability across training seeds, not sampling repeats.\n",
        "ap_3seed = (\n",
        "    ap_seed.groupby([\"spec_name\",\"native_t\",\"k_train\",\"train_layout\",\"k_test\",\"test_layout\",\"dataset\"], dropna=False)\n",
        "    [\"AP_repeat_mean\"].agg([\"mean\",\"std\"]).reset_index()\n",
        "    .rename(columns={\"mean\":\"AP_3seed_mean\",\"std\":\"AP_seed_SD\"})\n",
        ")\n",
        "\n",
        "delta_seed = wide.groupby(\n",
        "    [\"spec_name\",\"checkpoint_seed\",\"native_t\",\"k_train\",\"train_layout\",\"k_test\",\"dataset\"], dropna=False\n",
        ")[\"delta_average_precision_pp\"].mean().reset_index(name=\"delta_AP_pp_repeat_mean\")\n",
        "\n",
        "delta_3seed = (\n",
        "    delta_seed.groupby([\"spec_name\",\"native_t\",\"k_train\",\"train_layout\",\"k_test\",\"dataset\"], dropna=False)\n",
        "    [\"delta_AP_pp_repeat_mean\"].agg([\"mean\",\"std\"]).reset_index()\n",
        "    .rename(columns={\"mean\":\"delta_AP_pp_3seed_mean\",\"std\":\"delta_AP_pp_seed_SD\"})\n",
        ")\n",
        "\n",
        "ap_3seed.to_csv(EVAL_OUTPUT_DIR / \"condition_AP_3seed_summary.csv\", index=False)\n",
        "delta_3seed.to_csv(EVAL_OUTPUT_DIR / \"layout_delta_AP_3seed_summary.csv\", index=False)\n",
        "\n",
        "# Prediction diagnostics: summarize first within seed, then across seeds.\n",
        "pred_seed = (\n",
        "    pred_diag_df.groupby([\"spec_name\",\"checkpoint_seed\",\"native_t\",\"k_train\",\"train_layout\",\"k_test\",\"dataset\"], dropna=False)\n",
        "    [[\"mean_abs_delta_p\",\"median_abs_delta_p\",\"prediction_flip_rate\",\"spearman_rho\"]]\n",
        "    .mean().reset_index()\n",
        ")\n",
        "pred_3seed = (\n",
        "    pred_seed.groupby([\"spec_name\",\"native_t\",\"k_train\",\"train_layout\",\"k_test\",\"dataset\"], dropna=False)\n",
        "    [[\"mean_abs_delta_p\",\"median_abs_delta_p\",\"prediction_flip_rate\",\"spearman_rho\"]]\n",
        "    .agg([\"mean\",\"std\"]).reset_index()\n",
        ")\n",
        "pred_3seed.columns = [\n",
        "    \"_\".join([str(x) for x in col if str(x) != \"\"]) if isinstance(col, tuple) else str(col)\n",
        "    for col in pred_3seed.columns\n",
        "]\n",
        "pred_3seed.to_csv(EVAL_OUTPUT_DIR / \"layout_prediction_diagnostics_3seed_summary.csv\", index=False)\n",
        "\n",
        "# Console tables for the four manuscript-level domains.\n",
        "core_domains = [\"SOURCE_POOLED\", \"RWF\", \"UCF_Fighting\", \"BusViolence\"]\n",
        "print(\"\\n=== Layout effect: ΔAP = interleaved - grouped (percentage points) ===\")\n",
        "display(\n",
        "    delta_3seed[delta_3seed[\"dataset\"].isin(core_domains)]\n",
        "    .sort_values([\"spec_name\",\"k_test\",\"dataset\"])\n",
        "    .round(4)\n",
        ")\n",
        "print(\"\\n=== Sample-level layout diagnostics ===\")\n",
        "display(\n",
        "    pred_3seed[pred_3seed[\"dataset\"].isin(core_domains)]\n",
        "    .sort_values([\"spec_name\",\"k_test\",\"dataset\"])\n",
        "    .round(4)\n",
        ")\n",
        "\n",
        "print(\"Saved all summaries to:\", EVAL_OUTPUT_DIR)\n",
        "\n",
        "# ============================================================\n",
        "# EFFECT DECOMPOSITION: K effect versus layout effect\n",
        "# ============================================================\n",
        "# Layout effect at fixed K:\n",
        "#   AP(interleaved) - AP(grouped)\n",
        "# K effect at fixed layout:\n",
        "#   AP(K=4) - AP(K=2)\n",
        "\n",
        "ap_condition_seed = (\n",
        "    metrics_df.groupby(\n",
        "        [\n",
        "            \"spec_name\", \"checkpoint_seed\", \"native_t\",\n",
        "            \"k_train\", \"train_layout\", \"k_test\",\n",
        "            \"test_layout\", \"dataset\"\n",
        "        ],\n",
        "        dropna=False\n",
        "    )[\"average_precision\"]\n",
        "    .mean()\n",
        "    .reset_index(name=\"AP_repeat_mean\")\n",
        ")\n",
        "\n",
        "layout_wide = (\n",
        "    ap_condition_seed.pivot_table(\n",
        "        index=[\n",
        "            \"spec_name\", \"checkpoint_seed\", \"native_t\",\n",
        "            \"k_train\", \"train_layout\", \"k_test\", \"dataset\"\n",
        "        ],\n",
        "        columns=\"test_layout\",\n",
        "        values=\"AP_repeat_mean\",\n",
        "        aggfunc=\"first\",\n",
        "    )\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "layout_wide[\"delta_layout_AP_pp\"] = 100.0 * (\n",
        "    layout_wide[\"interleaved\"] - layout_wide[\"grouped\"]\n",
        ")\n",
        "\n",
        "k_wide = (\n",
        "    ap_condition_seed.pivot_table(\n",
        "        index=[\n",
        "            \"spec_name\", \"checkpoint_seed\", \"native_t\",\n",
        "            \"k_train\", \"train_layout\", \"test_layout\", \"dataset\"\n",
        "        ],\n",
        "        columns=\"k_test\",\n",
        "        values=\"AP_repeat_mean\",\n",
        "        aggfunc=\"first\",\n",
        "    )\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "if 2 not in k_wide.columns or 4 not in k_wide.columns:\n",
        "    raise RuntimeError(\"K=2 and K=4 are required for K-effect decomposition.\")\n",
        "\n",
        "k_wide[\"delta_K4_minus_K2_AP_pp\"] = 100.0 * (k_wide[4] - k_wide[2])\n",
        "\n",
        "layout_wide.to_csv(\n",
        "    EVAL_OUTPUT_DIR / \"layout_effect_AP_within_seed.csv\",\n",
        "    index=False,\n",
        ")\n",
        "k_wide.to_csv(\n",
        "    EVAL_OUTPUT_DIR / \"K4_minus_K2_effect_AP_within_seed.csv\",\n",
        "    index=False,\n",
        ")\n",
        "\n",
        "layout_effect_3seed = (\n",
        "    layout_wide.groupby(\n",
        "        [\"spec_name\",\"native_t\",\"k_train\",\"train_layout\",\"k_test\",\"dataset\"],\n",
        "        dropna=False\n",
        "    )[\"delta_layout_AP_pp\"]\n",
        "    .agg([\"mean\",\"std\"])\n",
        "    .reset_index()\n",
        "    .rename(columns={\n",
        "        \"mean\":\"delta_layout_AP_pp_3seed_mean\",\n",
        "        \"std\":\"delta_layout_AP_pp_seed_SD\",\n",
        "    })\n",
        ")\n",
        "\n",
        "k_effect_3seed = (\n",
        "    k_wide.groupby(\n",
        "        [\"spec_name\",\"native_t\",\"k_train\",\"train_layout\",\"test_layout\",\"dataset\"],\n",
        "        dropna=False\n",
        "    )[\"delta_K4_minus_K2_AP_pp\"]\n",
        "    .agg([\"mean\",\"std\"])\n",
        "    .reset_index()\n",
        "    .rename(columns={\n",
        "        \"mean\":\"delta_K4_minus_K2_AP_pp_3seed_mean\",\n",
        "        \"std\":\"delta_K4_minus_K2_AP_pp_seed_SD\",\n",
        "    })\n",
        ")\n",
        "\n",
        "layout_effect_3seed.to_csv(\n",
        "    EVAL_OUTPUT_DIR / \"layout_effect_AP_3seed_summary.csv\",\n",
        "    index=False,\n",
        ")\n",
        "k_effect_3seed.to_csv(\n",
        "    EVAL_OUTPUT_DIR / \"K4_minus_K2_effect_AP_3seed_summary.csv\",\n",
        "    index=False,\n",
        ")\n",
        "\n",
        "print(\"\\n=== Layout effect at fixed K: interleaved - grouped (AP pp) ===\")\n",
        "display(\n",
        "    layout_effect_3seed[\n",
        "        layout_effect_3seed[\"dataset\"].isin(core_domains)\n",
        "    ].sort_values([\"spec_name\",\"k_test\",\"dataset\"]).round(4)\n",
        ")\n",
        "\n",
        "print(\"\\n=== K effect at fixed layout: K4 - K2 (AP pp) ===\")\n",
        "display(\n",
        "    k_effect_3seed[\n",
        "        k_effect_3seed[\"dataset\"].isin(core_domains)\n",
        "    ].sort_values([\"spec_name\",\"test_layout\",\"dataset\"]).round(4)\n",
        ")\n"
      ]
    },
