      "source": [
        "\n",
        "from scipy.stats import spearmanr\n",
        "\n",
        "\n",
        "def make_condition_loader(dataset_name, store, k_test, test_layout, repeat_id):\n",
        "    feature_path, label_path, color_order = store\n",
        "    ds = NpyVideoSegmentDataset(\n",
        "        feature_path,\n",
        "        label_path,\n",
        "        indices=None,\n",
        "        color_order=color_order,\n",
        "        training=False,\n",
        "        dataset_name=dataset_name,\n",
        "        k_unique=int(k_test),\n",
        "        repeat_layout=str(test_layout),\n",
        "        eval_repeat_id=int(repeat_id),\n",
        "    )\n",
        "    generator = torch.Generator()\n",
        "    generator.manual_seed(SAMPLING_BASE_SEED)\n",
        "    return DataLoader(\n",
        "        ds,\n",
        "        batch_size=BATCH_SIZE,\n",
        "        shuffle=False,\n",
        "        drop_last=False,\n",
        "        num_workers=NUM_WORKERS,\n",
        "        pin_memory=(DEVICE.type == \"cuda\"),\n",
        "        worker_init_fn=seed_worker,\n",
        "        generator=generator,\n",
        "        persistent_workers=(NUM_WORKERS > 0),\n",
        "    )\n",
        "\n",
        "\n",
        "def load_eval_model(best_path: Path):\n",
        "    model = VideoMobileNetComparator(use_tsm=True, pretrained=False).to(DEVICE)\n",
        "    ckpt = safe_torch_load(best_path, map_location=DEVICE)\n",
        "    state = ckpt[\"model_state_dict\"] if isinstance(ckpt, dict) and \"model_state_dict\" in ckpt else ckpt\n",
        "    model.load_state_dict(state, strict=True)\n",
        "    model.eval()\n",
        "    if getattr(model, \"tsm_blocks\", None) != EXPECTED_TSM_BLOCKS:\n",
        "        raise RuntimeError(\n",
        "            f\"TSM block count mismatch: expected {EXPECTED_TSM_BLOCKS}, got {getattr(model, 'tsm_blocks', None)}\"\n",
        "        )\n",
        "    return model\n",
        "\n",
        "\n",
        "def _add_source_pooled_metrics(metrics_rows, pred_parts, common_meta):\n",
        "    source_parts = [df for df in pred_parts if df.iloc[0][\"dataset\"] in POOLED_DATASETS]\n",
        "    if not source_parts:\n",
        "        return\n",
        "    pooled = pd.concat(source_parts, ignore_index=True)\n",
        "    yt = pooled[\"y_true\"].to_numpy(dtype=np.int64)\n",
        "    yp = pooled[\"y_pred\"].to_numpy(dtype=np.int64)\n",
        "    pp = pooled[\"p_violence\"].to_numpy(dtype=np.float64)\n",
        "    m = compute_classification_metrics(yt, yp, pp)\n",
        "    row = dict(common_meta)\n",
        "    row[\"dataset\"] = \"SOURCE_POOLED\"\n",
        "    row.update(m)\n",
        "    metrics_rows.append(row)\n",
        "\n",
        "\n",
        "all_metrics = []\n",
        "all_predictions = []\n",
        "criterion = nn.CrossEntropyLoss()\n",
        "\n",
        "for spec in CHECKPOINT_SPECS:\n",
        "    for seed in SEEDS:\n",
        "        best_path = RESOLVED_CHECKPOINTS[(spec[\"spec_name\"], seed)]\n",
        "        print(\"\\n\" + \"=\"*90)\n",
        "        print(f\"Evaluating {spec['spec_name']} | seed={seed}\")\n",
        "        print(best_path)\n",
        "        model = load_eval_model(best_path)\n",
        "\n",
        "        for k_test in K_TEST_VALUES:\n",
        "            for repeat_id in range(K_EVAL_REPEATS):\n",
        "                # IMPORTANT: same k/repeat/sample temporal selections are shared by both layouts.\n",
        "                for test_layout in TEST_LAYOUTS:\n",
        "                    pred_parts_this_condition = []\n",
        "                    common = {\n",
        "                        \"spec_name\": spec[\"spec_name\"],\n",
        "                        \"checkpoint_seed\": seed,\n",
        "                        \"native_t\": NATIVE_T,\n",
        "                        \"k_train\": spec[\"k_train\"],\n",
        "                        \"train_layout\": spec[\"train_layout\"],\n",
        "                        \"k_test\": k_test,\n",
        "                        \"test_layout\": test_layout,\n",
        "                        \"repeat_id\": repeat_id,\n",
        "                        \"checkpoint\": str(best_path),\n",
        "                    }\n",
        "\n",
        "                    for dataset_name, store in TEST_STORES.items():\n",
        "                        loader = make_condition_loader(\n",
        "                            dataset_name, store, k_test, test_layout, repeat_id\n",
        "                        )\n",
        "                        metrics_i, sample_indices, y_true, y_pred, probs = evaluate_loader(\n",
        "                            model, loader, criterion\n",
        "                        )\n",
        "\n",
        "                        row = dict(common)\n",
        "                        row[\"dataset\"] = dataset_name\n",
        "                        row.update(metrics_i)\n",
        "                        all_metrics.append(row)\n",
        "\n",
        "                        pdf = pd.DataFrame({\n",
        "                            **{k: [v]*len(y_true) for k, v in common.items()},\n",
        "                            \"dataset\": dataset_name,\n",
        "                            \"sample_index\": sample_indices,\n",
        "                            \"y_true\": y_true,\n",
        "                            \"y_pred\": y_pred,\n",
        "                            \"p_nonviolence\": probs[:, 0],\n",
        "                            \"p_violence\": probs[:, 1],\n",
        "                        })\n",
        "                        all_predictions.append(pdf)\n",
        "                        pred_parts_this_condition.append(pdf)\n",
        "\n",
        "                    _add_source_pooled_metrics(all_metrics, pred_parts_this_condition, common)\n",
        "\n",
        "        del model\n",
        "        if DEVICE.type == \"cuda\":\n",
        "            torch.cuda.empty_cache()\n",
        "\n",
        "metrics_df = pd.DataFrame(all_metrics)\n",
        "predictions_df = pd.concat(all_predictions, ignore_index=True)\n",
        "\n",
        "metrics_path = EVAL_OUTPUT_DIR / \"layout_control_metrics.csv\"\n",
        "pred_path = EVAL_OUTPUT_DIR / \"layout_control_predictions.csv\"\n",
        "metrics_df.to_csv(metrics_path, index=False)\n",
        "predictions_df.to_csv(pred_path, index=False)\n",
        "print(\"Saved:\", metrics_path)\n",
        "print(\"Saved:\", pred_path)\n"
      ]
    },
