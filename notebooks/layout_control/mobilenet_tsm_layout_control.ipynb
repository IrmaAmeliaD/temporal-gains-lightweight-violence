      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "✅ Evaluation-only temporal sampler audit passed.\n",
            "Native T=8 grid: [1, 3, 5, 7, 9, 11, 13, 15]\n"
          ]
