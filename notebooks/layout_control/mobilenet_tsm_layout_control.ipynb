          "output_type": "stream",
          "name": "stdout",
          "text": [
            "✅ Pairing audit passed: same A/B(/C/D), only repetition order differs.\n"
          ]
        }
      ],
      "source": [
        "\n",
        "# ============================================================\n",
        "# AUDIT: grouped dan interleaved HARUS memakai unique frames yang sama\n",
        "# ============================================================\n",
        "audit_rows = []\n",
        "for k in K_TEST_VALUES:\n",
        "    for repeat_id in range(min(3, K_EVAL_REPEATS)):\n",
        "        unique_pos = _select_unique_t_positions(\n",
        "            k_unique=k,\n",
        "            training=False,\n",
        "            dataset_name=\"RWF\",\n",
        "            source_idx=0,\n",
        "            repeat_id=repeat_id,\n",
        "        )\n",
        "        grouped_pos = expand_positions(unique_pos, \"grouped\")\n",
        "        interleaved_pos = expand_positions(unique_pos, \"interleaved\")\n",
        "\n",
        "        # Multiset harus identik; yang berbeda hanya urutannya.\n",
        "        assert np.array_equal(np.sort(grouped_pos), np.sort(interleaved_pos))\n",
        "        assert len(np.unique(grouped_pos)) == k\n",
        "        assert len(np.unique(interleaved_pos)) == k\n",
        "\n",
        "        audit_rows.append({\n",
        "            \"k\": k,\n",
        "            \"repeat_id\": repeat_id,\n",
        "            \"unique_positions\": unique_pos.tolist(),\n",
        "            \"grouped\": grouped_pos.tolist(),\n",
        "            \"interleaved\": interleaved_pos.tolist(),\n",
        "            \"same_multiset\": True,\n",
        "        })\n",
        "\n",
        "audit_df = pd.DataFrame(audit_rows)\n",
        "display(audit_df)\n",
        "print(\"✅ Pairing audit passed: same A/B(/C/D), only repetition order differs.\")\n"
      ]
    },
