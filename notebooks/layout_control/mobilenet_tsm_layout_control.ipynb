      "source": [
        "\n",
        "manifest = {\n",
        "    \"purpose\": \"Evaluation-only control separating repetition layout from number of distinct temporal observations.\",\n",
        "    \"no_training\": True,\n",
        "    \"native_t\": NATIVE_T,\n",
        "    \"k_test_values\": list(K_TEST_VALUES),\n",
        "    \"test_layouts\": list(TEST_LAYOUTS),\n",
        "    \"k_eval_repeats\": K_EVAL_REPEATS,\n",
        "    \"sampling_base_seed\": SAMPLING_BASE_SEED,\n",
        "    \"sampling_seed_uses_checkpoint_seed\": False,\n",
        "    \"pairing_rule\": (\n",
        "        \"For a fixed dataset/sample/K/repeat, grouped and interleaved use exactly the same selected unique \"\n",
        "        \"temporal positions; only their repeated ordering differs.\"\n",
        "    ),\n",
        "    \"checkpoint_specs\": CHECKPOINT_SPECS,\n",
        "    \"interpretation\": (\n",
        "        \"K=2 and K=4 are the informative layout controls. K=1 has only one distinct observation so grouped and \"\n",
        "        \"interleaved are identical; K=T=8 has no repetition layout. Small paired layout effects relative to the \"\n",
        "        \"K-related effects support the interpretation that the observed degradation is not primarily caused by \"\n",
        "        \"grouped-versus-interleaved repetition. Large layout effects require retaining a layout-sensitivity caveat.\"\n",
        "    ),\n",
        "}\n",
        "with open(EVAL_OUTPUT_DIR / \"layout_control_manifest.json\", \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(manifest, f, indent=2, default=json_default)\n",
        "\n",
        "archive_base = str(EVAL_OUTPUT_DIR.parent / f\"{EVAL_OUTPUT_DIR.name}_results\")\n",
        "archive_path = shutil.make_archive(archive_base, \"zip\", root_dir=EVAL_OUTPUT_DIR)\n",
        "print(\"ZIP:\", archive_path)\n",
        "print(\"Results remain in:\", EVAL_OUTPUT_DIR)\n"
      ]
    }
