      "source": [
        "\n",
        "def _read_checkpoint_config(best_path: Path):\n",
        "    run_dir = best_path.parent\n",
        "    config_path = run_dir / \"config.json\"\n",
        "    if config_path.exists():\n",
        "        with open(config_path, \"r\", encoding=\"utf-8\") as f:\n",
        "            return json.load(f)\n",
        "    try:\n",
        "        ckpt = safe_torch_load(best_path, map_location=\"cpu\")\n",
        "        cfg = ckpt.get(\"config\", {}) if isinstance(ckpt, dict) else {}\n",
        "        return cfg if isinstance(cfg, dict) else {}\n",
        "    except Exception:\n",
        "        return {}\n",
        "\n",
        "\n",
        "def _direct_candidate_paths(spec: dict, seed: int):\n",
        "    variant = spec[\"variant\"]\n",
        "    candidates = [\n",
        "        COMPARATORS_ROOT / f\"Zhang2022_{variant}_Seed{seed}_v1\" / variant / f\"seed_{seed}\" / \"best.pt\",\n",
        "    ]\n",
        "\n",
        "    # Native T=8 has an older naming convention from the original TSM baseline:\n",
        "    #   Zhang2022_mobilenet_tsm_SeedX_v1/\n",
        "    #   └── mobilenet_tsm/seed_X/best.pt\n",
        "    #\n",
        "    # Newer native-T runs may instead use mobilenet_tsm_native_T8.\n",
        "    if spec[\"spec_name\"] == \"Native_T8\":\n",
        "        candidates.extend([\n",
        "            COMPARATORS_ROOT\n",
        "            / f\"Zhang2022_mobilenet_tsm_Seed{seed}_v1\"\n",
        "            / \"mobilenet_tsm\"\n",
        "            / f\"seed_{seed}\"\n",
        "            / \"best.pt\",\n",
        "\n",
        "            COMPARATORS_ROOT\n",
        "            / f\"mobilenet_tsm_Seed{seed}_v1\"\n",
        "            / \"mobilenet_tsm\"\n",
        "            / f\"seed_{seed}\"\n",
        "            / \"best.pt\",\n",
        "        ])\n",
        "\n",
        "        legacy_variants = [\n",
        "            \"mobilenet_tsm_native_T8\",\n",
        "            \"mobilenet_tsm_T8\",\n",
        "            \"mobilenet_tsm_native_t8\",\n",
        "        ]\n",
        "        for legacy in legacy_variants:\n",
        "            candidates.extend([\n",
        "                COMPARATORS_ROOT / f\"Zhang2022_{legacy}_Seed{seed}_v1\" / legacy / f\"seed_{seed}\" / \"best.pt\",\n",
        "                COMPARATORS_ROOT / f\"Zhang2022_{legacy}_Seed{seed}\" / legacy / f\"seed_{seed}\" / \"best.pt\",\n",
        "            ])\n",
        "\n",
        "    return list(dict.fromkeys(candidates))\n",
        "\n",
        "\n",
        "def _config_matches_spec(cfg: dict, path: Path, spec: dict, seed: int):\n",
        "    path_text = str(path).lower()\n",
        "\n",
        "    cfg_seed = cfg.get(\"seed\", cfg.get(\"run_seed\", None))\n",
        "    if cfg_seed is not None and int(cfg_seed) != int(seed):\n",
        "        return False\n",
        "\n",
        "    native_t = cfg.get(\"native_t\", cfg.get(\"physical_input_length_t\", cfg.get(\"num_segments\", None)))\n",
        "    if native_t is not None and int(native_t) != 8:\n",
        "        return False\n",
        "\n",
        "    use_tsm_cfg = cfg.get(\"use_tsm\", None)\n",
        "    if use_tsm_cfg is not None and not bool(use_tsm_cfg):\n",
        "        return False\n",
        "    if \"notsm\" in path_text or \"no_tsm\" in path_text:\n",
        "        return False\n",
        "\n",
        "    k_cfg = cfg.get(\"k_train\", None)\n",
        "    if k_cfg is not None:\n",
        "        if int(k_cfg) != int(spec[\"k_train\"]):\n",
        "            return False\n",
        "    else:\n",
        "        # Legacy T=8 TSM checkpoints predate the K_train field.\n",
        "        # The original baseline was saved as \"mobilenet_tsm\" and is the\n",
        "        # native T=8 / K=8 condition.\n",
        "        if spec[\"spec_name\"] != \"Native_T8\" or int(spec[\"k_train\"]) != 8:\n",
        "            return False\n",
        "\n",
        "        # Explicitly reject native T1/T2/T4 and controlled Ktrain<8 runs.\n",
        "        reject_tokens = [\n",
        "            \"native_t1\", \"native_t2\", \"native_t4\",\n",
        "            \"nativet1\", \"nativet2\", \"nativet4\",\n",
        "            \"ktrain1\", \"ktrain2\", \"ktrain4\",\n",
        "        ]\n",
        "        if any(tok in path_text for tok in reject_tokens):\n",
        "            return False\n",
        "\n",
        "        legacy_t8_path = (\n",
        "            \"mobilenet_tsm\" in path_text\n",
        "            or \"native_t8\" in path_text\n",
        "            or \"nativet8\" in path_text\n",
        "        )\n",
        "        if not legacy_t8_path:\n",
        "            return False\n",
        "\n",
        "    layout_cfg = cfg.get(\"train_repeat_layout\", cfg.get(\"train_layout\", None))\n",
        "    if spec[\"k_train\"] < 8 and layout_cfg is not None:\n",
        "        if str(layout_cfg).lower() != spec[\"train_layout\"].lower():\n",
        "            return False\n",
        "\n",
        "    return True\n",
        "\n",
        "\n",
        "def resolve_best_checkpoint(spec: dict, seed: int) -> Path:\n",
        "    override = CHECKPOINT_OVERRIDES.get((spec[\"spec_name\"], seed))\n",
        "    if override:\n",
        "        p = Path(override)\n",
        "        if not p.exists():\n",
        "            raise FileNotFoundError(f\"Override checkpoint tidak ditemukan: {p}\")\n",
        "        return p\n",
        "\n",
        "    # 1) Exact expected paths first.\n",
        "    direct_candidates = _direct_candidate_paths(spec, seed)\n",
        "    for p in direct_candidates:\n",
        "        if p.exists():\n",
        "            cfg = _read_checkpoint_config(p)\n",
        "            if _config_matches_spec(cfg, p, spec, seed):\n",
        "                return p\n",
        "\n",
        "    # 2) Safe recursive discovery by config/path metadata.\n",
        "    matches = []\n",
        "    if COMPARATORS_ROOT.exists():\n",
        "        for p in COMPARATORS_ROOT.rglob(\"best.pt\"):\n",
        "            # Fast path filtering before reading config.\n",
        "            txt = str(p).lower()\n",
        "            if \"tsm\" not in txt or f\"seed_{seed}\" not in txt:\n",
        "                continue\n",
        "            cfg = _read_checkpoint_config(p)\n",
        "            if _config_matches_spec(cfg, p, spec, seed):\n",
        "                matches.append(p)\n",
        "\n",
        "    # Prefer exact variant token when available.\n",
        "    exact_token = spec[\"variant\"].lower()\n",
        "    exact_matches = [p for p in matches if exact_token in str(p).lower()]\n",
        "    if len(exact_matches) == 1:\n",
        "        return exact_matches[0]\n",
        "    if len(exact_matches) > 1:\n",
        "        matches = exact_matches\n",
        "\n",
        "    if len(matches) == 1:\n",
        "        return matches[0]\n",
        "    if len(matches) == 0:\n",
        "        tried = \"\\n\".join(f\"  - {p}\" for p in direct_candidates)\n",
        "        raise FileNotFoundError(\n",
        "            f\"Checkpoint tidak ditemukan untuk {spec['spec_name']} seed={seed}.\\n\"\n",
        "            f\"Search root: {COMPARATORS_ROOT}\\n\"\n",
        "            f\"Direct paths yang sudah dicoba:\\n{tried}\\n\"\n",
        "            \"Jika struktur folder Anda berbeda, isi CHECKPOINT_OVERRIDES dengan path file best.pt.\"\n",
        "        )\n",
        "\n",
        "    msg = \"\\n\".join(str(p) for p in matches)\n",
        "    raise RuntimeError(\n",
        "        f\"Ditemukan lebih dari satu checkpoint untuk {spec['spec_name']} seed={seed}:\\n{msg}\\n\"\n",
        "        \"Pilih checkpoint yang benar melalui CHECKPOINT_OVERRIDES.\"\n",
        "    )\n",
        "\n",
        "\n",
        "resolved_rows = []\n",
        "RESOLVED_CHECKPOINTS = {}\n",
        "for spec in CHECKPOINT_SPECS:\n",
        "    for seed in SEEDS:\n",
        "        p = resolve_best_checkpoint(spec, seed)\n",
        "        cfg = _read_checkpoint_config(p)\n",
        "        RESOLVED_CHECKPOINTS[(spec[\"spec_name\"], seed)] = p\n",
        "        resolved_rows.append({\n",
        "            \"spec_name\": spec[\"spec_name\"],\n",
        "            \"seed\": seed,\n",
        "            \"expected_k_train\": spec[\"k_train\"],\n",
        "            \"expected_train_layout\": spec[\"train_layout\"],\n",
        "            \"checkpoint\": str(p),\n",
        "            \"config_native_t\": cfg.get(\"native_t\", cfg.get(\"physical_input_length_t\")),\n",
        "            \"config_k_train\": cfg.get(\"k_train\", None),\n",
        "            \"config_train_layout\": cfg.get(\"train_repeat_layout\", cfg.get(\"train_layout\", None)),\n",
        "            \"config_use_tsm\": cfg.get(\"use_tsm\", None),\n",
        "        })\n",
        "\n",
        "resolved_df = pd.DataFrame(resolved_rows)\n",
        "display(resolved_df)\n",
        "resolved_df.to_csv(EVAL_OUTPUT_DIR / \"resolved_checkpoints.csv\", index=False)\n",
        "print(\"✅ Semua checkpoint berhasil di-resolve sebelum inference.\")\n"
      ]
    },
