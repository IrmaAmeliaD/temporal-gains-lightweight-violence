      "source": [
        "## 4. Temporal sampling dan paired layout construction"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "54a06928",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
