            "/content/drive/MyDrive/IVS/ViolenceDetection/Models/Comparators/mobilenet_tsm_Seed123_v1/mobilenet_tsm/seed_123/best.pt\n",
            "Saved: /content/drive/MyDrive/IVS/ViolenceDetection/Models/Comparators/LayoutControl_TSM_T8_K2K4_EvalOnly_v1/layout_control_metrics.csv\n",
            "Saved: /content/drive/MyDrive/IVS/ViolenceDetection/Models/Comparators/LayoutControl_TSM_T8_K2K4_EvalOnly_v1/layout_control_predictions.csv\n"
          ]
